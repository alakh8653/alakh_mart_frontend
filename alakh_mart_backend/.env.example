# Django secret
SECRET_KEY=change-me-local
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
DB_NAME=alakh_mart
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# Kubernetes / Production hints
# Use DATABASE_URL for twelve-factor deployments (optional)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Optional: set DATABASE_URL for 12-factor deployments
# Example: DATABASE_URL=postgres://postgres:postgres@db:5432/alakh_mart
# Email (SMTP) settings for sending receipts
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@alakhmart.local
