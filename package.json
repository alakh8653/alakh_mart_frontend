{
  "name": "alakh-mart-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "A large advanced e-commerce frontend scaffold similar to Amazon built with Next.js + TypeScript",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init --preview-feature",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@next-auth/prisma-adapter": "^1.0.5",
    "@prisma/client": "^5.12.0",
    "axios": "^1.6.0",
    "clsx": "^1.2.1",
    "date-fns": "^2.30.0",
    "next": "14.2.0",
    "next-auth": "^4.22.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "swr": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.22.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.0",
    "@storybook/addon-links": "^7.6.0",
    "@storybook/react": "^7.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.5",
    "@types/node": "20.3.1",
    "@types/react": "18.2.21",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.40.0",
    "eslint-config-next": "14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.21",
    "prettier": "^3.6.0",
    "prisma": "^5.12.0",
    "storybook": "^7.6.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "5.4.2"
  }
}
